3. 파싱 후 메모리 최적화 한 equirectTexture 생성
'''
hdrData.data가 채널당 32비트인데, 이게 지원되려면 EXT_color_buffer_float 가 있어야함
지원 되긴 하는데, 왜 동작않하는지 잘모르겠음.
그런데 메모리 문제가 있어서 채널당 8비트가 좋은것 같음. --> uint8
그래서 32비트를 0 ~ 255로 변환해서 8비트 어레이에 담음
1024 x 1024 텍스처 4배 메모리 절감 효과 발생
32비트: 1024 * 1024 * (4 * 4(rgba)) * 6 (큐브맵 면) = 96 MB
8비트 : 1024 * 1024 * (1 * 4(rgba)) * 6 = 24 MB
체널 당 32비트 채널로 만드려면 
- gl.RGBA --> gl.RGBA32F로 바꿔주어야 한다.
- gl.UNSIGNED_BYTE --> gl.FLOAT

gl.texImage2D(
  gl.TEXTURE_2D, 0,
  gl.RGBA32F, // gl.RGBA,
  width, height, 0,
  gl.RGBA, 
  gl.FLOAT, // gl.UNSIGNED_BYTE,
  hdrData.data // ubyteData
);
'''
onloadHDR(hdrData) {      
    // 파싱된 결과를 가져옴
    const width = hdrData.shape[0];
    const height = hdrData.shape[1];
    const floatData = hdrData.data;
    const ubyteData = new Uint8Array(width * height * 4);

    // exposure, gamma 보정 및 채널당 32->8 비트로 전환.
    for (let i = 0; i < floatData.length; i++) {
        // HDR 값을 노출(exposure)과 감마 보정 적용 후 0-255로 변환
        let value = floatData[i];
        value *= hdrData.exposure; // 노출 보정
        hdrData.gamma = 2.2;
        value = Math.pow(value, 1.0 / hdrData.gamma); // 감마 보정
        // 0 ~ 255 범위로 변환
        ubyteData[i] = Math.min(255, Math.max(0, Math.floor(value * 255)));
    }

// 파싱된 결과로 equirectTexture 생성
this.equirectTexture = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, this.equirectTexture);
    gl.texImage2D(
    gl.TEXTURE_2D, 0,
    gl.RGBA,
    width, height, 0,
    gl.RGBA, 
    gl.UNSIGNED_BYTE,
    ubyteData
);
gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
gl.bindTexture(gl.TEXTURE_2D, null);

